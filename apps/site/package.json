{
    "name": "site",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev --turbopack",
        "dev:node": "node ./node_modules/next/dist/bin/next dev --turbopack",
        "dev:bun": "bun --bun run dev",
        "build": "next build",
        "build:node": "node ./node_modules/next/dist/bin/next build",
        "build:bun": "bun --bun next build",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "start": "next start",
        "start:node": "node ./node_modules/next/dist/bin/next start",
        "start:bun": "bun --bun next start"
    },
    "dependencies": {
        "@nethack/contracts": "workspace:*",
        "@nethack/ui": "workspace:*",
        "lucide-react": "1.80.0",
        "next": "16.4.6",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "4.3.5",
        "@types/node": "26.6.10",
        "@types/react": "19.3.2",
        "@types/react-dom": "19.3.0",
        "tailwindcss": "4.3.5",
        "typescript": "6.0.3"
    }
}
