{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "lib": [
            "ES2023",
            "DOM",
            "DOM.Iterable"
        ],
        "types": [
            "vite/client"
        ],
        "noEmit": true,
        "paths": {
            "@nethack/ui": [
                "../../packages/ui/src/index.ts"
            ],
            "@nethack/contracts": [
                "../../packages/contracts/src/index.ts"
            ],
            "@nethack/api-client": [
                "../../packages/api-client/src/index.ts"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "vite.config.ts"
    ]
}
