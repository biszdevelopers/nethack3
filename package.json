{
    "name": "nethack3",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "bun run scripts/dev.ts",
        "dev:site": "bun run --filter site dev",
        "dev:workspace": "bun run --filter workspace dev",
        "dev:api": "bun run --filter api dev",
        "dev:node": "bun run scripts/dev.ts --node",
        "build": "bun run build:contracts && bun run build:ui && bun run build:api && bun run build:workspace && bun run build:site",
        "build:contracts": "bun run --filter @nethack/contracts build",
        "build:ui": "bun run --filter @nethack/ui build",
        "build:api": "bun run --filter api build",
        "build:workspace": "bun run --filter workspace build",
        "build:site": "bun run --filter site build",
        "typecheck": "bun run typecheck:contracts && bun run typecheck:ui && bun run typecheck:api && bun run typecheck:workspace && bun run typecheck:site",
        "typecheck:contracts": "bun run --filter @nethack/contracts typecheck",
        "typecheck:ui": "bun run --filter @nethack/ui typecheck",
        "typecheck:api": "bun run --filter api typecheck",
        "typecheck:workspace": "bun run --filter workspace typecheck",
        "typecheck:site": "bun run --filter site typecheck",
        "lint": "oxlint .",
        "format": "oxfmt .",
        "format:check": "oxfmt . --check",
        "security:scan": "bun run scripts/security-scan.ts",
        "db:prune-backups": "bun run scripts/prune-backups.ts",
        "test": "bun run test:unit && bun run test:ui",
        "test:unit": "bun scripts/run-node.ts ./node_modules/vitest/vitest.mjs run",
        "test:ui": "bun scripts/run-node.ts ./node_modules/vitest/vitest.mjs run --config packages/ui/vitest.config.ts",
        "test:watch": "bun scripts/run-node.ts ./node_modules/vitest/vitest.mjs",
        "test:architecture": "bun scripts/run-node.ts ./node_modules/vitest/vitest.mjs run tests/architecture",
        "test:integration": "bun scripts/run-node.ts ./node_modules/vitest/vitest.mjs run --config apps/api/vitest.config.ts",
        "test:security": "bun run scripts/run-node.ts ./node_modules/vitest/vitest.mjs run tests/security && bun run scripts/run-node.ts ./node_modules/vitest/vitest.mjs run --config apps/api/vitest.config.ts tests/security tests/auth",
        "test:e2e": "bun scripts/run-node.ts ./node_modules/@playwright/test/cli.js test",
        "test:visual": "bun scripts/run-node.ts ./node_modules/@playwright/test/cli.js test tests/e2e/09-accessibility.spec.ts",
        "test:performance": "bun run scripts/run-node.ts scripts/performance.ts",
        "test:load": "bun run tests/load/run.ts",
        "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
        "db:generate": "bun --filter api run db:generate",
        "db:migrate": "bun --filter api run db:migrate",
        "db:seed": "bun --filter api run db:seed",
        "db:start": "bun run scripts/database.ts start",
        "db:stop": "bun run scripts/database.ts stop",
        "verify:runtime": "bun run scripts/verify-runtime.ts",
        "audit:deps": "bun audit"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.1",
        "@playwright/test": "1.65.1",
        "@testing-library/jest-dom": "8.0.0",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.13",
        "@types/node": "26.6.10",
        "@types/nodemailer": "8.0.2",
        "@types/pg": "8.23.1",
        "@types/react": "19.3.2",
        "@types/react-dom": "19.3.0",
        "@vitest/coverage-v8": "5.1.1",
        "drizzle-kit": "0.31.11",
        "jsdom": "31.0.1",
        "lighthouse": "13.6.0",
        "oxfmt": "0.80.0",
        "oxlint": "1.95.0",
        "pg": "8.23.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "typescript": "6.0.3",
        "vitest": "5.1.1",
        "zod": "4.6.7"
    }
}
