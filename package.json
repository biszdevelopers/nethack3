{
    "name": "nethack3",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "bun run scripts/dev.ts",
        "dev:site": "bun --filter site run dev",
        "dev:workspace": "bun --filter workspace run dev",
        "dev:api": "bun --filter api run dev",
        "dev:node": "bun run scripts/dev.ts --node",
        "build": "bun run build:contracts && bun run build:ui && bun run build:api && bun run build:workspace && bun run build:site",
        "build:contracts": "bun --filter @nethack/contracts run build",
        "build:ui": "bun --filter @nethack/ui run build",
        "build:api": "bun --filter api run build",
        "build:workspace": "bun --filter workspace run build",
        "build:site": "bun --filter site run build",
        "typecheck": "bun run typecheck:contracts && bun run typecheck:ui && bun run typecheck:api && bun run typecheck:workspace && bun run typecheck:site",
        "typecheck:contracts": "bun --filter @nethack/contracts run typecheck",
        "typecheck:ui": "bun --filter @nethack/ui run typecheck",
        "typecheck:api": "bun --filter api run typecheck",
        "typecheck:workspace": "bun --filter workspace run typecheck",
        "typecheck:site": "bun --filter site run typecheck",
        "lint": "oxlint .",
        "format": "oxfmt .",
        "format:check": "oxfmt . --check",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:architecture": "vitest run tests/architecture",
        "test:integration": "vitest run tests/integration",
        "test:security": "vitest run tests/security",
        "test:e2e": "playwright test",
        "test:visual": "playwright test tests/visual",
        "test:load": "bun run tests/load/run.ts",
        "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
        "db:generate": "bun --filter api run db:generate",
        "db:migrate": "bun --filter api run db:migrate",
        "db:seed": "bun --filter api run db:seed",
        "db:start": "bun run scripts/database.ts start",
        "db:stop": "bun run scripts/database.ts stop",
        "verify:runtime": "bun run scripts/verify-runtime.ts",
        "audit:deps": "bun audit"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.1",
        "@playwright/test": "1.65.1",
        "@testing-library/jest-dom": "8.0.0",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.13",
        "@types/node": "26.6.10",
        "@types/nodemailer": "8.0.2",
        "@types/pg": "8.23.1",
        "@types/react": "19.3.2",
        "@types/react-dom": "19.3.0",
        "@vitest/coverage-v8": "5.1.1",
        "drizzle-kit": "0.31.11",
        "jsdom": "31.0.1",
        "oxfmt": "0.80.0",
        "oxlint": "1.95.0",
        "typescript": "6.0.3",
        "vitest": "5.1.1"
    }
}
