# Copy this file to deployment/.env.production and replace every placeholder.
# It is read by Docker Compose (--env-file and env_file) and by the database
# backup/restore scripts. Never commit the filled-in file.
#
# Passwords inside DATABASE_URL / DATABASE_MIGRATION_URL must be URL-encoded.

# ---------------------------------------------------------------------------
# Process
# ---------------------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=3002
LOG_LEVEL=info
TRUST_PROXY=true

# Public origins. All four must use HTTPS when NODE_ENV=production.
API_ORIGIN=https://api.nethack.example
WORKSPACE_ORIGIN=https://app.nethack.example
SITE_ORIGIN=https://www.nethack.example
ASSET_ORIGIN=https://assets.nethack.example
# Consumed by the Next.js site server and by the workspace build.
PUBLIC_API_ORIGIN=https://api.nethack.example
VITE_API_ORIGIN=https://api.nethack.example

# ---------------------------------------------------------------------------
# PostgreSQL container bootstrap (read by compose interpolation)
# ---------------------------------------------------------------------------
POSTGRES_DB=nethack
POSTGRES_USER=nethack
POSTGRES_PASSWORD=change-me-owner-password

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Runtime role: non-owner, no BYPASSRLS. Host "postgres" is the compose service.
DATABASE_URL=postgres://nethack_app:change-me-app-password@postgres:5432/nethack
DATABASE_POOL_MAX=10

# Owner/superuser role used only by the one-shot migration job, backup and restore.
DATABASE_MIGRATION_URL=postgres://nethack:change-me-owner-password@postgres:5432/nethack
MIGRATIONS_DIR=/app/database/migrations

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
SESSION_COOKIE_NAME=__Host-nethack_session
SESSION_TTL_SECONDS=604800
SESSION_CSRF_HEADER=x-csrf-token
# Comma-separated 32-byte base64 keys; the first key encrypts new values.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEYS=REPLACE_WITH_32_BYTE_BASE64_KEY

# ---------------------------------------------------------------------------
# Basis Auth
# ---------------------------------------------------------------------------
BASIS_AUTH_ISSUER=https://auth.example.com
BASIS_AUTH_CLIENT_ID=replace-with-client-id
BASIS_AUTH_CLIENT_SECRET=replace-with-client-secret
BASIS_AUTH_RESOURCE=devconnect://nethack.example
BASIS_AUTH_SCOPES=openid profile email offline_access nethack.access
BASIS_AUTH_RESOURCE_SECRET=replace-with-resource-secret
# Optional private issuer URL reachable from the api container; leave empty to use the public issuer.
BASIS_AUTH_INTERNAL_URL=
BASIS_AUTH_REDIRECT_URI=https://api.nethack.example/api/v1/auth/callback
BASIS_AUTH_POST_LOGOUT_REDIRECT_URI=https://app.nethack.example/
BASIS_AUTH_ALLOW_INSECURE_HTTP=false

# ---------------------------------------------------------------------------
# Storage and limits
# ---------------------------------------------------------------------------
STORAGE_ROOT=/data/storage
MAX_UPLOAD_BYTES=26214400
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Email and telemetry
# ---------------------------------------------------------------------------
SMTP_URL=smtps://replace-user:replace-password@smtp.example.com:465
EMAIL_FROM="nethack <no-reply@nethack.example>"
OTEL_EXPORTER_OTLP_ENDPOINT=
API_DOCS_ENABLED=false

LOGIN_TRANSACTION_TTL_SECONDS=600
REFRESH_SKEW_SECONDS=60
BACKCHANNEL_MAX_TOKEN_AGE_SECONDS=120

# ---------------------------------------------------------------------------
# Host-side backup/restore scripts (not used by the containers)
# ---------------------------------------------------------------------------
BACKUP_DIR=./backups
# Directory containing pg_dump/pg_restore/psql when they are not on PATH.
PG_BIN=
