NODE_ENV=development
HOST=127.0.0.1
PORT=3002
API_ORIGIN=http://localhost:3002
WORKSPACE_ORIGIN=http://localhost:5173
SITE_ORIGIN=http://localhost:3000
ASSET_ORIGIN=http://localhost:3002
TRUST_PROXY=false
LOG_LEVEL=info

# Runtime database credential. Use a non-owner role without BYPASSRLS in production.
DATABASE_URL=postgres://nethack_app:nethack_app_password@127.0.0.1:55432/nethack
DATABASE_POOL_MAX=10

# Migration credential. Keep separate from DATABASE_URL in production.
DATABASE_MIGRATION_URL=postgres://nethack:nethack_dev_password@127.0.0.1:55432/nethack

SESSION_COOKIE_NAME=__Host-nethack_session
SESSION_TTL_SECONDS=604800
SESSION_CSRF_HEADER=x-csrf-token
# Comma-separated 32-byte base64 keys. The first key encrypts new secrets.
SESSION_ENCRYPTION_KEYS=

BASIS_AUTH_ISSUER=http://localhost:4010
BASIS_AUTH_CLIENT_ID=nethack-dev
BASIS_AUTH_CLIENT_SECRET=nethack-dev-secret-value
BASIS_AUTH_RESOURCE=devconnect://nethack.bisz.dev
BASIS_AUTH_SCOPES=openid profile email offline_access nethack.access
BASIS_AUTH_RESOURCE_SECRET=nethack-dev-resource-secret
BASIS_AUTH_INTERNAL_URL=
BASIS_AUTH_REDIRECT_URI=http://localhost:3002/api/v1/auth/callback
BASIS_AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
BASIS_AUTH_ALLOW_INSECURE_HTTP=true

STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=26214400
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

SMTP_URL=
EMAIL_FROM=nethack <no-reply@nethack.local>

OTEL_EXPORTER_OTLP_ENDPOINT=
API_DOCS_ENABLED=true

LOGIN_TRANSACTION_TTL_SECONDS=600
REFRESH_SKEW_SECONDS=60
BACKCHANNEL_MAX_TOKEN_AGE_SECONDS=120
